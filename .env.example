PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sentinel
SENTINEL_API_URL=http://localhost:3000

# Optional: enables real Gemini contextual analysis for ambiguous authorization
# decisions (no matched policy rule, or a pending human REVIEW). The policy
# engine's ALLOW/REVIEW/BLOCK decision is always final and unaffected by this;
# Gemini only supplies advisory analysis text for human reviewers. If unset or
# left as the placeholder below, Sentinel falls back to a deterministic
# regex-based mock advisory and still functions fully.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
